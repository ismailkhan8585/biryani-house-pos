# Supabase Project URL & Anon Key (from https://supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (from Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for securing branch & admin sessions
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Owner bootstrap account (first login only; create other named users in Settings)
ADMIN_USERNAME=ilyas_owner
MASTER_PASSWORD=V9!qL7#rT2@xM8$wK5&z
